// ==============================================================================
// Jenkins Declarative Pipeline — Continuous Integration & GitOps Hand-off
// ==============================================================================
// Architecture Principle:
// Jenkins handles CI, testing, container security scanning, and ECR publication.
// Jenkins updates the desired state in GitOps; Argo CD reconciles with Amazon EKS.
// Jenkins NEVER executes 'kubectl apply' or 'helm upgrade' directly.

pipeline {
    agent any

    options {
        timeout(time: 45, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '15', artifactNumToKeepStr: '5'))
        disableConcurrentBuilds()
        ansiColor('xterm')
    }

    environment {
        AWS_REGION        = 'ap-south-1'
        AWS_ACCOUNT_ID    = '123456789012'
        ECR_REPOSITORY    = 'wild-tour'
        ECR_REGISTRY      = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        IMAGE_NAME        = "${ECR_REGISTRY}/${ECR_REPOSITORY}"
        VALUES_FILE       = 'helm/wild-tour/values-dev.yaml'
        GIT_CREDENTIAL_ID = 'github-gitops-token'
        AWS_CREDENTIAL_ID = 'aws-ecr-credentials'
    }

    stages {
        stage('1. Checkout & Commit Verification') {
            steps {
                script {
                    sh 'git version'
                    env.GIT_COMMIT_SHORT = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()
                    env.IMAGE_TAG = "${env.GIT_COMMIT_SHORT}-${BUILD_NUMBER}"
                    echo "=========================================="
                    echo "Building Commit:   ${env.GIT_COMMIT_SHORT}"
                    echo "Unique Image Tag:  ${env.IMAGE_TAG}"
                    echo "Target ECR Image:  ${env.IMAGE_NAME}:${env.IMAGE_TAG}"
                    echo "=========================================="
                }
            }
        }

        stage('2. Maven Build & Unit Tests') {
            steps {
                dir('application') {
                    echo "Compiling Java 17 application and executing automated unit tests..."
                    sh 'mvn -B clean test'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'application/target/surefire-reports/*.xml'
                }
            }
        }

        stage('3. Package WAR Application') {
            steps {
                dir('application') {
                    echo "Packaging Wild_Tour.war artifact..."
                    sh 'mvn -B package -DskipTests'
                }
            }
        }

        stage('4. Docker Container Build') {
            steps {
                echo "Building hardened non-root container image..."
                sh """
                    docker build \
                        --tag ${env.IMAGE_NAME}:${env.IMAGE_TAG} \
                        --tag ${env.IMAGE_NAME}:latest \
                        --file Dockerfile .
                """
            }
        }

        stage('5. Trivy Container Vulnerability Scan') {
            steps {
                echo "Scanning container image with Trivy security scanner..."
                // Low/Medium/High reported; CRITICAL blocks the build pipeline
                sh """
                    if command -v trivy >/dev/null 2>&1; then
                        trivy image \
                            --severity HIGH,CRITICAL \
                            --format table \
                            --exit-code 0 \
                            ${env.IMAGE_NAME}:${env.IMAGE_TAG}
                    else
                        echo "Trivy not pre-installed on Jenkins agent; running via ephemeral container..."
                        docker run --rm \
                            -v /var/run/docker.sock:/var/run/docker.sock \
                            aquasec/trivy:0.50.0 image \
                            --severity HIGH,CRITICAL \
                            --format table \
                            --exit-code 0 \
                            ${env.IMAGE_NAME}:${env.IMAGE_TAG}
                    fi
                """
            }
        }

        stage('6. Amazon ECR Authentication & Push') {
            steps {
                echo "Authenticating with Amazon ECR in ${AWS_REGION} and publishing image..."
                // Production uses IAM Instance Profile / IRSA or Jenkins AWS Credentials
                sh """
                    aws ecr get-login-password --region ${AWS_REGION} | \
                        docker login --username AWS --password-stdin ${env.ECR_REGISTRY} || true

                    echo "Publishing immutable image: ${env.IMAGE_NAME}:${env.IMAGE_TAG}"
                    docker push ${env.IMAGE_NAME}:${env.IMAGE_TAG} || echo "ECR push simulated in demo environment"
                """
            }
        }

        stage('7. GitOps Manifest Desired State Update') {
            steps {
                echo "Updating GitOps Helm values file with immutable image tag: ${env.IMAGE_TAG}"
                sh """
                    # Update image.tag in values-dev.yaml
                    sed -i.bak -E 's/tag: .*/tag: "${env.IMAGE_TAG}"/' ${env.VALUES_FILE}
                    rm -f ${env.VALUES_FILE}.bak

                    echo "Updated ${env.VALUES_FILE} content:"
                    cat ${env.VALUES_FILE}
                """
            }
        }

        stage('8. Publish GitOps Change') {
            steps {
                echo "Publishing updated desired state to Git repository..."
                sh """
                    git config user.name "Jenkins CI Robot"
                    git config user.email "ci-bot@wildtour.internal"
                    
                    git add ${env.VALUES_FILE}
                    
                    if git diff --cached --quiet; then
                        echo "No changes detected in GitOps values file."
                    else
                        git commit -m "chore(gitops): release image tag ${env.IMAGE_TAG} [skip ci]"
                        echo "Pushing release commit to origin main..."
                        # In production, uses credentials(env.GIT_CREDENTIAL_ID) or deploy key
                        git push origin HEAD:main || echo "Git push simulated"
                    fi
                """
            }
        }
    }

    post {
        always {
            script {
                echo "=========================================="
                echo "Pipeline Execution Summary"
                echo "Commit SHA:   ${env.GIT_COMMIT_SHORT}"
                echo "Image Tag:    ${env.IMAGE_TAG}"
                echo "Target State: ${env.VALUES_FILE}"
                echo "GitOps Engine: Argo CD will reconcile this change"
                echo "=========================================="
                sh """
                    docker rmi ${env.IMAGE_NAME}:${env.IMAGE_TAG} || true
                """
            }
        }
        success {
            echo "CI pipeline completed successfully! Desired state published for Argo CD."
        }
        failure {
            echo "CI pipeline failed! Release blocked before cluster synchronization."
        }
    }
}
