# ==============================================================================
# GitOps EKS Platform — Git Ignore Rules
# ==============================================================================

# Compiled Java / Maven artifacts
**/target/
*.class
*.jar
*.war
*.ear

# IDE & Editor files
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# Terraform files
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
.terraform.lock.hcl.backup
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Secrets, Credentials, and Certificates (CRITICAL - NEVER COMMIT)
*.pem
*.key
*.pkcs12
*.pfx
*.p12
*.id_rsa
*.id_ed25519
*.crt
*.csr
credentials
credentials.json
.env
.env.*
!*.env.example

# Kubernetes / Helm
kubeconfig*
*.kubeconfig
*.tgz

# OS / Misc
.DS_Store
Thumbs.db
desktop.ini
*.log
scratch/
tmp/
